@@ -211,6 +211,13 @@ class PaperPluginInstanceManager {
                     enableTask.run();
                 }
             } catch (Throwable ex) {
+                if (io.papermc.paper.plugin.HybridPluginRuntime.isUnsupportedOperation(ex)) {
+                    this.server.getLogger().severe(String.format(
+                        "[%s] Plugin '%s' performed an operation that the AethraSea Hybrid Engine does not support.%n" +
+                            "It may be reading or writing world/region data from a thread Folia does not permit.%n" +
+                            "Use a Folia-region-aware build of this plugin for this feature. (%s)",
+                        plugin.getPluginMeta().getDisplayName(), plugin.getPluginMeta().getDisplayName(), ex.getMessage()));
+                }
                 this.server.getLogger().log(Level.SEVERE, "Error occurred while enabling " + plugin.getPluginMeta().getDisplayName() + " (Is it up to date?)", ex);
                 // Paper start - Disable plugins that fail to load
                 this.server.getPluginManager().disablePlugin(jPlugin);
@@ -253,6 +260,11 @@ class PaperPluginInstanceManager {
                     disableTask.run();
                 }
             } catch (Throwable ex) {
+                if (io.papermc.paper.plugin.HybridPluginRuntime.isUnsupportedOperation(ex)) {
+                    this.server.getLogger().severe(String.format(
+                        "[%s] Shutting down of plugin '%s' during an unsupported AethraSea Hybrid Engine operation failed. (%s)",
+                        pluginName, pluginName, ex.getMessage()));
+                }
                 this.server.getLogger().log(Level.SEVERE, "Error occurred while disabling " + pluginName, ex);
             }
 
diff --git a/src/main/java/io/papermc/paper/threadedregions/HybridRegionRead.java b/src/main/java/io/papermc/paper/threadedregions/HybridRegionRead.java
index 2190692114af5506a6dda8e6e612e02f86072182..2046018ba443758810313937dc61298e08427822 100644
--- a/src/main/java/io/papermc/paper/threadedregions/HybridRegionRead.java
+++ b/src/main/java/io/papermc/paper/threadedregions/HybridRegionRead.java
@@ -1,9 +1,13 @@
 package io.papermc.paper.threadedregions;
 
 import java.util.concurrent.CompletableFuture;
-import java.util.concurrent.CompletionException;
+import java.util.concurrent.ExecutionException;
+import java.util.concurrent.TimeUnit;
+import java.util.concurrent.TimeoutException;
 import java.util.function.Supplier;
 import net.minecraft.server.level.ServerLevel;
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
 
 /**
  * AethraSea Hybrid Engine - bridge between the legacy "main thread" simulation and Folia's region
@@ -16,9 +20,19 @@ import net.minecraft.server.level.ServerLevel;
  * never a Folia region/global thread, so region threads keep ticking and nothing can deadlock or
  * trip the watchdog. Native Folia threads are never rerouted - for them the access executes inline,
  * preserving Folia's normal semantics (an illegal off-region access still throws).
+ *
+ * <p>The wait is bounded because region ticking has not started during plugin {@code onEnable} (it
+ * only begins once {@code RegionizedServer#init()} runs after worlds load): a routed read queued in
+ * that window would otherwise never complete. On timeout the supplier is executed inline, which
+ * reproduces the pre-hybrid behavior (the Folia main-thread check throws and the caller handles it)
+ * instead of hanging the boot.
  */
 public final class HybridRegionRead {
 
+    private static final Logger LOGGER = LoggerFactory.getLogger(HybridRegionRead.class);
+
+    private static final long MAX_WAIT_MILLIS = 750L;
+
     private HybridRegionRead() {
     }
 
@@ -40,9 +54,18 @@ public final class HybridRegionRead {
         });
         RegionizedServer.getInstance().notifyTasks();
         try {
-            return gate.join();
-        } catch (final CompletionException e) {
-            throw unwrap(e);
+            return gate.get(MAX_WAIT_MILLIS, TimeUnit.MILLISECONDS);
+        } catch (final TimeoutException timeout) {
+            if (LOGGER.isWarnEnabled()) {
+                LOGGER.warn("AethraSea Hybrid Engine: {} read from legacy code at chunk ({}, {}) is not supported while the region scheduler has not started ticking yet; executing inline (the calling plugin must use a Folia-region-aware build for this access).",
+                    level.dimension().location(), chunkX, chunkZ);
+            }
+            return supplier.get();
+        } catch (final ExecutionException e) {
+            throw rethrow(e.getCause());
+        } catch (final InterruptedException e) {
+            Thread.currentThread().interrupt();
+            throw new RuntimeException(e);
         }
     }
 
@@ -53,11 +76,11 @@ public final class HybridRegionRead {
         });
     }
 
-    private static RuntimeException unwrap(final CompletionException e) {
-        final Throwable cause = e.getCause() != null ? e.getCause() : e;
-        if (cause instanceof RuntimeException) {
-            return (RuntimeException) cause;
+    private static RuntimeException rethrow(final Throwable cause) {
+        final Throwable root = cause != null ? cause : new IllegalStateException("Unknown hybrid read failure");
+        if (root instanceof RuntimeException) {
+            return (RuntimeException) root;
         }
-        return new RuntimeException(cause);
+        return new RuntimeException(root);
     }
 }
