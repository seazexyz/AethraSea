diff --git a/src/main/java/io/papermc/paper/plugin/HybridPluginRuntime.java b/src/main/java/io/papermc/paper/plugin/HybridPluginRuntime.java
index 73bdb8418e39d77ab647e7ef7dec2e7997875d9f..52d4e9351b501219e2ad33a2a6fe0e16ae728217 100644
--- a/src/main/java/io/papermc/paper/plugin/HybridPluginRuntime.java
+++ b/src/main/java/io/papermc/paper/plugin/HybridPluginRuntime.java
@@ -112,6 +112,35 @@ public final class HybridPluginRuntime {
         }
     }
 
+    // Message fragments that identify a failed access which the AethraSea Hybrid Engine cannot
+    // satisfy for a legacy plugin. Such operations must be performed by a Folia-region-aware build
+    // of the plugin instead.
+    private static final String[] UNSUPPORTED_MARKERS = {
+        "cannot read world asynchronously",
+        "main thread check",
+        "owning world's region thread",
+        "reads from the wrong region",
+        "world access from the wrong thread",
+        "aethrasea hybrid engine"
+    };
+
+    /**
+     * Returns whether the given throwable (including its cause chain) stems from an operation that
+     * the AethraSea Hybrid Engine does not support, such as a legacy plugin accessing world data in
+     * a way that Folia's region threading forbids.
+     */
+    public static boolean isUnsupportedOperation(final Throwable throwable) {
+        for (Throwable current = throwable; current != null; current = current.getCause()) {
+            final String message = String.valueOf(current.getMessage()).toLowerCase(Locale.ENGLISH);
+            for (final String marker : UNSUPPORTED_MARKERS) {
+                if (message.contains(marker)) {
+                    return true;
+                }
+            }
+        }
+        return false;
+    }
+
     private static String normalize(final String name) {
         return name.replace(' ', '_').toLowerCase(Locale.ENGLISH);
     }
diff --git a/src/main/java/io/papermc/paper/plugin/manager/PaperPluginInstanceManager.java b/src/main/java/io/papermc/paper/plugin/manager/PaperPluginInstanceManager.java
index 203afc0c90d70b4868839c1277519b078d73e13c..6cea14923795b3d1b15973c4b7e6a2a2b8ddc529 100644
