diff --git a/src/main/java/io/papermc/paper/plugin/HybridPluginRuntime.java b/src/main/java/io/papermc/paper/plugin/HybridPluginRuntime.java
new file mode 100644
index 0000000000000000000000000000000000000000..130e5d743974057605fcfe9769d6257dd7b70c88
--- /dev/null
+++ b/src/main/java/io/papermc/paper/plugin/HybridPluginRuntime.java
@@ -0,0 +1,111 @@
+package io.papermc.paper.plugin;
+
+import java.util.HashSet;
+import java.util.Locale;
+import java.util.Map;
+import java.util.Set;
+import java.util.WeakHashMap;
+import org.bukkit.plugin.Plugin;
+
+/**
+ * AethraSea Hybrid Engine - core runtime classification of plugins.
+ *
+ * <p>Legacy single-threaded Paper/Spigot plugins (loaded from {@code plugins/paper}) are tracked so
+ * that the Folia region-threading guards can be relaxed for them, while native Folia region-aware
+ * plugins ({@code plugins/folia}) keep the full region threading model.</p>
+ */
+public final class HybridPluginRuntime {
+
+    // Set while scanning legacy plugin sources; consulted by FileProviderSource to attribute scans.
+    private static final ThreadLocal<Boolean> LEGACY_SOURCE = ThreadLocal.withInitial(() -> Boolean.FALSE);
+
+    private static final Object LOCK = new Object();
+    // Plugin names detected in legacy sources (normalized index-space), retained across reloads.
+    private static final Set<String> LEGACY_NAMES = new HashSet<>();
+    // Live plugin instances classified as legacy, keyed weakly so unloaded plugins can be GC'd.
+    private static final Map<Plugin, Boolean> LEGACY_INSTANCES = new WeakHashMap<>();
+
+    private HybridPluginRuntime() {
+    }
+
+    /**
+     * Marks whether the current thread is scanning a legacy plugin source.
+     *
+     * @return the previous value, for restore-in-finally patterns
+     */
+    public static boolean setLegacySource(final boolean legacy) {
+        final boolean prev = LEGACY_SOURCE.get();
+        LEGACY_SOURCE.set(legacy);
+        return prev;
+    }
+
+    /**
+     * Runs the given scanner with the legacy-source flag active on the current thread.
+     */
+    public static void inLegacySource(final Runnable scanner) {
+        final boolean prev = setLegacySource(true);
+        try {
+            scanner.run();
+        } finally {
+            setLegacySource(prev);
+        }
+    }
+
+    public static boolean isLegacySourceActive() {
+        return LEGACY_SOURCE.get();
+    }
+
+    /**
+     * Records a plugin name as legacy. Only takes effect while a legacy source scan is active.
+     */
+    public static void markLegacyName(final String pluginName) {
+        if (!isLegacySourceActive()) {
+            return;
+        }
+        synchronized (LOCK) {
+            LEGACY_NAMES.add(normalize(pluginName));
+        }
+    }
+
+    /**
+     * Called when a plugin instance has been created; classifies it as legacy if its name was
+     * detected during a legacy source scan.
+     */
+    public static void registerInstance(final Plugin plugin) {
+        if (!isLegacyName(plugin.getName())) {
+            return;
+        }
+        synchronized (LOCK) {
+            LEGACY_INSTANCES.put(plugin, Boolean.TRUE);
+        }
+    }
+
+    /**
+     * Returns whether the given plugin must run under the legacy single-threaded model.
+     *
+     * <p>A {@code null} owner represents internal scheduler bookkeeping, which is always
+     * legacy (it must run on the virtual main thread).</p>
+     */
+    public static boolean isLegacyPaperPlugin(final Plugin plugin) {
+        if (plugin == null) {
+            return true;
+        }
+        synchronized (LOCK) {
+            if (LEGACY_INSTANCES.containsKey(plugin)) {
+                return true;
+            }
+        }
+        return isLegacyName(plugin.getName());
+    }
+
+    private static boolean isLegacyName(final String pluginName) {
+        final String normalized = normalize(pluginName);
+        synchronized (LOCK) {
+            return LEGACY_NAMES.contains(normalized);
+        }
+    }
+
+    private static String normalize(final String name) {
+        return name.replace(' ', '_').toLowerCase(Locale.ENGLISH);
+    }
+}
\ No newline at end of file
