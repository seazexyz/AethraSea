@@ -514,16 +514,30 @@ public class CraftScheduler implements BukkitScheduler {
     }
 
     protected CraftTask handle(final CraftTask task, final long delay) { // Paper
-        if (true) throw new UnsupportedOperationException(); // Folia - region threading
+        // AethraSea Hybrid Engine start - allow legacy (single-threaded) and internal tasks, keep
+        // the Folia guard for native region-aware plugins.
+        if (!io.papermc.paper.plugin.HybridPluginRuntime.isLegacyPaperPlugin(task.getOwner())) {
+            throw new UnsupportedOperationException(); // Folia - region threading
+        }
         // Paper start
         if (!this.isAsyncScheduler && !task.isSync()) {
             this.asyncScheduler.handle(task, delay);
             return task;
         }
         // Paper end
-        task.setNextRun(this.currentTick + delay);
-        this.addTask(task);
+        if (this.isAsyncScheduler || io.papermc.paper.threadedregions.PaperVirtualMainThread.isVirtualMainThread()) {
+            task.setNextRun(this.currentTick + delay);
+            this.addTask(task);
+            return task;
+        }
+        // We are on an arbitrary region thread: hand the bookkeeping to the virtual main thread,
+        // which exclusively owns currentTick, temp and pending (see class javadoc).
+        io.papermc.paper.threadedregions.PaperVirtualMainThread.schedule(() -> {
+            task.setNextRun(this.currentTick + delay);
+            this.addTask(task);
+        });
         return task;
+        // AethraSea Hybrid Engine end
     }
 
     private static void validate(final Plugin plugin, final Object task) {
