+        // correct source classification from the very beginning.
+        relocateFoliaCompatiblePlugins(pluginSystem.pluginDirectoryPath().resolve("paper"));
+        relocateFoliaCompatiblePlugins(pluginSystem.pluginDirectoryPath());
+
