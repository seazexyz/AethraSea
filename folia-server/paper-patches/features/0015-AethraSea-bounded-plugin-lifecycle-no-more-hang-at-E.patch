@@ -154,6 +163,74 @@ public class PluginInitializerManager {
         }
     }
 
+    // AethraSea Hybrid Engine start - auto-relocation of Folia-compatible plugins
+
+    /**
+     * Scans the given legacy plugin directory for plugin jars whose {@code plugin.yml} declares
+     * {@code folia-supported: true} (or references the Folia API) and moves them into
+     * {@code plugins/folia}. This ensures a Folia-aware plugin is never forced through the legacy
+     * single-threaded virtual-main-thread shim.
+     */
+    private static void relocateFoliaCompatiblePlugins(final Path legacyDir) {
+        if (legacyDir == null || !Files.isDirectory(legacyDir)) {
+            return;
+        }
+        final Path foliaDir = legacyDir.resolveSibling("folia");
+        try {
+            Files.createDirectories(foliaDir);
+        } catch (final IOException e) {
+            LOGGER.error("[AethraSea] Could not create plugins/folia directory for auto-relocation", e);
+            return;
+        }
+        try (java.util.stream.Stream<Path> jars = Files.list(legacyDir)) {
+            jars.filter(path -> path.getFileName().toString().toLowerCase(java.util.Locale.ENGLISH).endsWith(".jar"))
+                .forEach(jar -> relocateIfFoliaCompatible(jar, foliaDir));
+        } catch (final IOException e) {
+            LOGGER.warn("[AethraSea] Failed to scan {} for Folia-compatible plugins", legacyDir, e);
+        }
+    }
+
+    private static void relocateIfFoliaCompatible(final Path jar, final Path foliaDir) {
+        try (final java.util.jar.JarFile jarFile = new java.util.jar.JarFile(jar.toFile())) {
+            final java.util.jar.Manifest manifest = jarFile.getManifest();
+            if (manifest != null) {
+                final String foliaAttribute = manifest.getMainAttributes().getValue("Folia-Supported");
+                if (foliaAttribute != null && Boolean.parseBoolean(foliaAttribute)) {
+                    movePluginJar(jar, foliaDir);
+                    return;
+                }
+            }
+            final java.util.jar.JarEntry pluginYml = jarFile.getJarEntry("plugin.yml");
+            if (pluginYml == null) {
+                return;
+            }
+            final YamlConfiguration config = YamlConfiguration.loadConfiguration(
+                new java.io.BufferedReader(new java.io.InputStreamReader(jarFile.getInputStream(pluginYml), java.nio.charset.StandardCharsets.UTF_8))
+            );
+            if (config.getBoolean("folia-supported", false) || config.getBoolean("folia-supported.enabled", false)) {
+                movePluginJar(jar, foliaDir);
+            }
+        } catch (final IOException e) {
+            LOGGER.warn("[AethraSea] Could not inspect plugin jar {} for Folia compatibility", jar.getFileName(), e);
+        }
+    }
+
+    private static void movePluginJar(final Path jar, final Path foliaDir) {
+        final String fileName = jar.getFileName().toString();
+        final Path destination = foliaDir.resolve(fileName);
+        try {
+            if (Files.exists(destination)) {
+                Files.deleteIfExists(destination);
+            }
+            Files.move(jar, destination);
+            LOGGER.info("[AethraSea] Detected Folia-compatible plugin '{}' in the legacy plugins/ folder - auto-relocated to plugins/folia/.", fileName);
+        } catch (final IOException e) {
+            LOGGER.error("[AethraSea] Could not auto-relocate {} to {}: {}", fileName, destination, e.getMessage());
+        }
+    }
+
+    // AethraSea Hybrid Engine end - auto-relocation of Folia-compatible plugins
+
     // This will be the end of me...
     public static void reload(DedicatedServer dedicatedServer) {
         // Wipe the provider storage
