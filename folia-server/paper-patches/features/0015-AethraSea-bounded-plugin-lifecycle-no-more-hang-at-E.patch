diff --git a/src/main/java/org/bukkit/craftbukkit/scheduler/CraftScheduler.java b/src/main/java/org/bukkit/craftbukkit/scheduler/CraftScheduler.java
index 83ef76ff73ae8a663a3a301b5459e97e29458ae9..6c4b2bed9fd7993ea7a39a4563746220de5bc074 100644
--- a/src/main/java/org/bukkit/craftbukkit/scheduler/CraftScheduler.java
+++ b/src/main/java/org/bukkit/craftbukkit/scheduler/CraftScheduler.java
@@ -526,6 +526,28 @@ public class CraftScheduler implements BukkitScheduler {
         }
         // Paper end
         if (this.isAsyncScheduler || io.papermc.paper.threadedregions.PaperVirtualMainThread.isVirtualMainThread()) {
+            // AethraSea Hybrid Engine start - prevent nested deadlock: when already on the virtual
+            // main thread with a zero-delay sync task (the common callSyncMethod pattern), run it
+            // inline. Scheduling it would require mainThreadHeartbeat() to tick, but the heartbeat
+            // cannot advance while the current task (e.g. onEnable) is still executing.
+            if (!this.isAsyncScheduler && task.isSync() && delay == 0 && io.papermc.paper.threadedregions.PaperVirtualMainThread.isVirtualMainThread()) {
+                try {
+                    task.run();
+                } catch (final Throwable throwable) {
+                    final String logMessage = String.format(
+                        "Task #%s for %s generated an exception",
+                        task.getTaskId(),
+                        task.getOwner().getDescription().getFullName());
+                    task.getOwner().getLogger().log(
+                            Level.WARNING,
+                        logMessage,
+                            throwable);
+                    org.bukkit.Bukkit.getServer().getPluginManager().callEvent(
+                        new com.destroystokyo.paper.event.server.ServerExceptionEvent(new com.destroystokyo.paper.exception.ServerSchedulerException(logMessage, throwable, task)));
+                }
+                return task;
+            }
+            // AethraSea Hybrid Engine end - prevent nested deadlock
             task.setNextRun(this.currentTick + delay);
             this.addTask(task);
             return task;
