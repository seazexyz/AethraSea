From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Builder <builder@folia.local>
Date: Tue, 8 Sep 2026 20:47:32 +0700
Subject: [PATCH] AethraSea: enable dynamic world create/unload; finish init
 async on the new world's own region


diff --git a/src/main/java/org/bukkit/craftbukkit/CraftServer.java b/src/main/java/org/bukkit/craftbukkit/CraftServer.java
index da22f40a3ab3282b12981e86c05f92b3eed38f6a..6f1e9701843542c007650b7942c447de49eb21a3 100644
--- a/src/main/java/org/bukkit/craftbukkit/CraftServer.java
+++ b/src/main/java/org/bukkit/craftbukkit/CraftServer.java
@@ -1197,7 +1197,13 @@ public final class CraftServer implements Server {
 
     @Override
     public World createWorld(WorldCreator creator) {
-        if (true) throw new UnsupportedOperationException(); // Folia - not implemented properly yet
+        // AethraSea Hybrid Engine - re-enable dynamic world creation. NOTE: this must run inline on the
+        // calling thread (which may be a Folia region thread) rather than being handed off to the virtual
+        // main thread, because synchronously blocking a region thread trips the Folia watchdog.
+        return createWorld0(creator);
+    }
+
+    private World createWorld0(WorldCreator creator) {
         Preconditions.checkState(this.console.getAllLevels().iterator().hasNext(), "Cannot create additional worlds on STARTUP");
         //Preconditions.checkState(!this.console.isIteratingOverLevels, "Cannot create a world while worlds are being ticked"); // Paper - Cat - Temp disable. We'll see how this goes.
         Preconditions.checkArgument(creator != null, "WorldCreator cannot be null");
@@ -1338,12 +1344,23 @@ public final class CraftServer implements Server {
             return null;
         }
 
+        // AethraSea Hybrid Engine - register the new world with the Folia regionized scheduler and
+        // finish initialization asynchronously on the new world's OWN region. Chunk loading (spawn
+        // generation inside initWorld) is only legal on that world's region thread, and blocking the
+        // calling region thread would trip the Folia watchdog, so this tail is queued, not awaited.
         this.console.addLevel(serverLevel);
-        this.console.initWorld(serverLevel, creator);
-
-        serverLevel.setSpawnSettings(true);
-
-        this.getServer().prepareLevel(serverLevel);
+        io.papermc.paper.threadedregions.RegionizedServer.getInstance().addWorld(serverLevel);
+        this.worlds.put(name.toLowerCase(Locale.ROOT), serverLevel.getWorld());
+
+        final net.minecraft.server.MinecraftServer console = this.console;
+        io.papermc.paper.threadedregions.RegionizedServer.getInstance().taskQueue.queueTickTaskQueue(
+            serverLevel, 0, 0, () -> {
+                console.initWorld(serverLevel, creator);
+                serverLevel.setSpawnSettings(true);
+                new org.bukkit.event.world.WorldLoadEvent(serverLevel.getWorld()).callEvent();
+            }
+        );
+        io.papermc.paper.threadedregions.RegionizedServer.getInstance().notifyTasks();
 
         return serverLevel.getWorld();
     }
@@ -1355,7 +1372,11 @@ public final class CraftServer implements Server {
 
     @Override
     public boolean unloadWorld(World world, boolean save) {
-        if (true) throw new UnsupportedOperationException(); // Folia - not implemented properly yet
+        // AethraSea Hybrid Engine - re-enable dynamic world unload, run inline (see createWorld note re: watchdog).
+        return unloadWorld0(world, save);
+    }
+
+    private boolean unloadWorld0(World world, boolean save) {
         //Preconditions.checkState(!this.console.isIteratingOverLevels, "Cannot unload a world while worlds are being ticked"); // Paper - Cat - Temp disable. We'll see how this goes.
         if (world == null) {
             return false;
