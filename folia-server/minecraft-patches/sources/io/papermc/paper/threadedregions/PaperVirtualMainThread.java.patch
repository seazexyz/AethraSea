+package io.papermc.paper.threadedregions;
+
+import com.mojang.logging.LogUtils;
+import java.util.concurrent.CompletableFuture;
+import java.util.concurrent.TimeUnit;
+import java.util.concurrent.TimeoutException;
+import java.util.concurrent.atomic.AtomicBoolean;
+import java.util.concurrent.locks.LockSupport;
+import org.bukkit.Bukkit;
+import org.bukkit.craftbukkit.CraftServer;
+import org.bukkit.craftbukkit.scheduler.CraftScheduler;
+import org.slf4j.Logger;
+
+/**
+ * AethraSea Hybrid Engine - the legacy single-threaded "main thread" simulator.
+ *
+ * <p>Legacy plugins expect a single thread that owns scheduler state and is reported by
+ * {@code Bukkit.isPrimaryThread()}. This thread advances {@link CraftScheduler#mainThreadHeartbeat()}
+ * at the 20 TPS cadence and executes bookkeeping/entry work handed over from region threads via a
+ * lock-free MPSC queue.</p>
+ *
+ * <p>Legacy sync scheduler tasks are executed from this thread so that {@code Bukkit.isPrimaryThread()}
+ * reads true while they run. The thread is a daemon, so it does not prevent the process from exiting.</p>
+ */
+public final class PaperVirtualMainThread {
+
+    private static final Logger LOGGER = LogUtils.getLogger();
+
+    private static final long TICK_INTERVAL_NANOS = TimeUnit.MILLISECONDS.toNanos(50L); // 20 TPS
+
+    private static final MpscQueue<Runnable> QUEUE = MpscQueue.create();
+    private static final AtomicBoolean STARTED = new AtomicBoolean();
+    private static volatile Thread VIRTUAL_THREAD;
+
+    private static final ThreadLocal<Boolean> ON_VIRTUAL_THREAD = ThreadLocal.withInitial(() -> Boolean.FALSE);
+    private static final java.util.concurrent.atomic.AtomicLong TICK_COUNTER = new java.util.concurrent.atomic.AtomicLong();
+
+    private PaperVirtualMainThread() {
+    }
+
+    public static void start() {
+        if (!STARTED.compareAndSet(false, true)) {
+            return;
+        }
+        final Thread thread = new Thread(PaperVirtualMainThread::runLoop, "Paper-Virtual-Main-Thread");
+        thread.setDaemon(true);
+        VIRTUAL_THREAD = thread;
+        thread.start();
+    }
+
+    /**
+     * Hands a unit of work to the virtual main thread. Called from region threads for scheduler
+     * bookkeeping that must mutate main-thread-owned scheduler state.
+     */
+    public static void schedule(final Runnable runnable) {
+        start();
+        QUEUE.offer(runnable);
+    }
+
+    /**
+     * Executes the given runnable synchronously on the virtual main thread, blocking the calling
+     * thread until it completes. If the current thread is already the virtual main thread the
+     * runnable executes inline.
+     *
+     * <p>This is the entry point used to run a legacy plugin's {@code onEnable()}/{@code onDisable()}
+     * lifecycle such that {@code Bukkit.isPrimaryThread()} reports {@code true} while it runs.</p>
+     */
+    public static void execute(final Runnable runnable) {
+        if (isVirtualMainThread()) {
+            runnable.run();
+            return;
+        }
+        start();
+        final java.util.concurrent.CompletableFuture<Void> gate = new java.util.concurrent.CompletableFuture<>();
+        QUEUE.offer(() -> {
+            try {
+                runnable.run();
+            } finally {
+                gate.complete(null);
+            }
+        });
+        gate.join();
+    }
+
+    /**
+     * Executes the given callable synchronously on the virtual main thread and returns its result,
+     * blocking the calling thread until it completes. If the current thread is already the virtual
+     * main thread the callable executes inline.
+     *
+     * <p>This is the entry point used by legacy (single-threaded) API paths that must both run on the
+     * simulated main thread and produce a value, e.g. {@code CraftServer#createWorld}.</p>
+     */
+    public static <T> T execute(final java.util.concurrent.Callable<T> callable) {
+        if (isVirtualMainThread()) {
+            try {
+                return callable.call();
+            } catch (final RuntimeException re) {
+                throw re;
+            } catch (final Exception e) {
+                throw new RuntimeException(e);
+            }
+        }
+        start();
+        final CompletableFuture<T> gate = new CompletableFuture<>();
+        QUEUE.offer(() -> {
+            try {
+                gate.complete(callable.call());
+            } catch (final Throwable throwable) {
+                gate.completeExceptionally(throwable);
+            }
+        });
+        return gate.join();
+    }
+
+    // AethraSea Hybrid Engine start - timeout-bounded execute to prevent startup hangs
+
+    /**
+     * Executes the given runnable synchronously on the virtual main thread with a bounded wait.
+     * If the runnable does not complete within {@code timeoutNanos}, the caller is unblocked and
+     * the virtual thread is interrupted. Used by the plugin lifecycle to prevent a misbehaving
+     * plugin's {@code onEnable()} from freezing the entire startup.
+     */
+    public static void executeWithTimeout(final Runnable runnable, final long timeoutNanos) throws TimeoutException {
+        if (isVirtualMainThread()) {
+            runnable.run();
+            return;
+        }
+        start();
+        final CompletableFuture<Void> gate = new CompletableFuture<>();
+        final java.util.concurrent.atomic.AtomicBoolean abandoned = new java.util.concurrent.atomic.AtomicBoolean(false);
+        QUEUE.offer(() -> {
+            try {
+                // If the caller gave up (timed out and already disabled the plugin), do not start
+                // the task late - that would enable a plugin we already tore down.
+                if (!abandoned.get()) {
+                    runnable.run();
+                }
+            } finally {
+                gate.complete(null);
+            }
+        });
+        try {
+            gate.get(timeoutNanos, TimeUnit.NANOSECONDS);
+        } catch (final TimeoutException e) {
+            abandoned.set(true);
+            // The task is still in the queue or stuck inside onEnable(). Interrupt the virtual
+            // main thread so it can unwind (interruptible I/O such as JDBC will throw), then
+            // propagate the timeout to the caller.
+            final Thread virtualThread = VIRTUAL_THREAD;
+            if (virtualThread != null) {
+                virtualThread.interrupt();
+            }
+            throw e;
+        } catch (final java.util.concurrent.ExecutionException e) {
+            final Throwable cause = e.getCause();
+            if (cause instanceof RuntimeException rte) throw rte;
+            if (cause instanceof Error err) throw err;
+            throw new RuntimeException(cause);
+        } catch (final InterruptedException e) {
+            Thread.currentThread().interrupt();
+            throw new RuntimeException(e);
+        }
+    }
+
+    // AethraSea Hybrid Engine end - timeout-bounded execute
+
+    public static boolean isVirtualMainThread() {
+        return ON_VIRTUAL_THREAD.get();
+    }
+
+    /**
+     * Whether the current thread is (also) considered the legacy primary thread.
+     */
+    public static boolean isPrimaryThread() {
+        return isVirtualMainThread();
+    }
+
+    private static void runLoop() {
+        ON_VIRTUAL_THREAD.set(Boolean.TRUE);
+        long nextTickTime = System.nanoTime();
+
+        while (true) {
+            final boolean drained = drainQueue();
+
+            final long now = System.nanoTime();
+            if (now >= nextTickTime) {
+                do {
+                    heartbeat();
+                    nextTickTime += TICK_INTERVAL_NANOS;
+                } while (now >= nextTickTime + TICK_INTERVAL_NANOS);
+                // avoid a catch-up burst after a long stall
+                if (nextTickTime < now) {
+                    nextTickTime = now;
+                }
+                continue;
+            }
+
+            if (drained) {
+                // keep draining without sleeping while there was work
+                continue;
+            }
+
+            // AethraSea Hybrid Engine - clear any interrupt left by a lifecycle timeout so the
+            // park below can actually sleep (LockSupport.park is interruptible but does not throw).
+            Thread.interrupted();
+
+            LockSupport.parkNanos(nextTickTime - now);
+        }
+    }
+
+    private static boolean drainQueue() {
+        boolean didAny = false;
+        for (Runnable task; (task = QUEUE.poll()) != null; ) {
+            didAny = true;
+            try {
+                task.run();
+            } catch (final Throwable throwable) {
+                LOGGER.error("Error running queued task on the virtual main thread", throwable);
+            }
+        }
+        return didAny;
+    }
+
+    private static void heartbeat() {
+        if (!STARTED.get()) {
+            return;
+        }
+        final CraftServer server = (CraftServer) Bukkit.getServer();
+        if (server == null || server.isStopping()) {
+            return;
+        }
+        try {
+            final CraftScheduler scheduler = server.getScheduler();
+            if (scheduler != null) {
+                scheduler.mainThreadHeartbeat();
+            }
+            // AethraSea Hybrid Engine - publish the read-only snapshot on the legacy tick boundary
+            SnapshotCache.capture(TICK_COUNTER.incrementAndGet());
+        } catch (final Throwable throwable) {
+            LOGGER.error("Error ticking the legacy scheduler on the virtual main thread", throwable);
+        }
+    }
+}
