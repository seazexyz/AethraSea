+package dev.folia.sea.monitor;
+
+import ca.spottedleaf.common.time.TickData;
+import dev.folia.sea.config.SeaConfig;
+import io.papermc.paper.threadedregions.commands.CommandUtil;
+import net.kyori.adventure.bossbar.BossBar;
+import net.kyori.adventure.bossbar.BossBar.Color;
+import net.kyori.adventure.bossbar.BossBar.Overlay;
+import net.kyori.adventure.text.Component;
+import net.kyori.adventure.text.format.NamedTextColor;
+import net.kyori.adventure.text.format.TextColor;
+import net.minecraft.server.MinecraftServer;
+import org.bukkit.Bukkit;
+import org.bukkit.World;
+import org.bukkit.craftbukkit.CraftWorld;
+import org.bukkit.entity.Player;
+
+import java.text.DecimalFormat;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Map;
+import java.util.UUID;
+import java.util.concurrent.ConcurrentHashMap;
+
+/**
+ * AethraSea real-time performance HUD.
+ *
+ * <p>Ticked once per second from the global region thread. Pushes a boss bar to every player that
+ * toggled {@code /tpsbar} or {@code /rambar}, and optionally barks a warning to ops whenever the
+ * server median TPS drops below or the heap usage exceeds the configured sea.yml thresholds.</p>
+ */
+public final class SeaPerformanceMonitor {
+
+    private static final Map<UUID, BossBar> TPS_BAR_USERS = new ConcurrentHashMap<>();
+    private static final Map<UUID, BossBar> RAM_BAR_USERS = new ConcurrentHashMap<>();
+
+    private static final DecimalFormat TWO_DEC = new DecimalFormat("#,##0.00");
+    private static final DecimalFormat ONE_DEC = new DecimalFormat("#,##0.0");
+    private static final DecimalFormat NO_DEC = new DecimalFormat("#,##0");
+
+    private static long tickCount;
+
+    private SeaPerformanceMonitor() {
+    }
+
+    // ---- subscription management ----------------------------------------------------------
+
+    public static boolean isTpsBarEnabled(final UUID uuid) {
+        return TPS_BAR_USERS.containsKey(uuid);
+    }
+
+    public static boolean isRamBarEnabled(final UUID uuid) {
+        return RAM_BAR_USERS.containsKey(uuid);
+    }
+
+    public static void setTpsBarEnabled(final UUID uuid, final boolean enabled) {
+        if (enabled) {
+            TPS_BAR_USERS.computeIfAbsent(uuid, ignored -> createBossBar());
+        } else {
+            removeBossBar(TPS_BAR_USERS.remove(uuid), uuid);
+        }
+    }
+
+    public static void setRamBarEnabled(final UUID uuid, final boolean enabled) {
+        if (enabled) {
+            RAM_BAR_USERS.computeIfAbsent(uuid, ignored -> createBossBar());
+        } else {
+            removeBossBar(RAM_BAR_USERS.remove(uuid), uuid);
+        }
+    }
+
+    private static BossBar createBossBar() {
+        return BossBar.bossBar(Component.empty(), 0.0f, Color.GREEN, Overlay.PROGRESS);
+    }
+
+    private static void removeBossBar(final BossBar bar, final UUID uuid) {
+        if (bar == null) {
+            return;
+        }
+        final Player player = Bukkit.getPlayer(uuid);
+        if (player != null) {
+            player.hideBossBar(bar);
+        }
+    }
+
+    // ---- periodic tick --------------------------------------------------------------------
+
+    /**
+     * Called from the global region tick. Does the actual work at a 1 Hz cadence.
+     */
+    public static void tick() {
+        final long currentTick = ++tickCount;
+        if ((currentTick % 20) != 0) {
+            return;
+        }
+        if (TPS_BAR_USERS.isEmpty() && RAM_BAR_USERS.isEmpty() && !SeaConfig.isMonitorWarningEnabled()) {
+            return;
+        }
+
+        final long now = System.nanoTime();
+        final TpsSnapshot tps = computeServerTps(now);
+
+        final Runtime rt = Runtime.getRuntime();
+        final long usedMb = (rt.totalMemory() - rt.freeMemory()) >> 20;
+        final long maxMb = Math.max(usedMb, rt.maxMemory() >> 20);
+        final int ramPercent = (int) (maxMb == 0 ? 0 : (usedMb * 100.0 / maxMb));
+
+        if (!TPS_BAR_USERS.isEmpty()) {
+            pushTpsBars(tps);
+        }
+        if (!RAM_BAR_USERS.isEmpty()) {
+            pushRamBars(usedMb, maxMb, ramPercent);
+        }
+        pushWarnings(tps, usedMb, maxMb, ramPercent);
+    }
+
+    // ---- boss bar refresh ------------------------------------------------------------------
+
+    private static void pushTpsBars(final TpsSnapshot tps) {
+        final Component title = buildTpsBar(tps);
+        final float progress = (float) Math.max(0.0, Math.min(tps.medianTps / 20.0, 1.0));
+        final Color colour = tps.medianTps >= 18.0 ? Color.GREEN
+            : tps.medianTps >= 10.0 ? Color.YELLOW
+            : Color.RED;
+
+        for (final Map.Entry<UUID, BossBar> entry : TPS_BAR_USERS.entrySet()) {
+            final Player player = Bukkit.getPlayer(entry.getKey());
+            if (player == null) {
+                continue;
+            }
+            final BossBar bar = entry.getValue();
+            if (!hasBossBar(player, bar)) {
+                player.showBossBar(bar);
+            }
+            bar.name(title);
+            bar.progress(progress);
+            bar.color(colour);
+        }
+    }
+
+    private static void pushRamBars(final long usedMb, final long maxMb, final int ramPercent) {
+        final Component title = buildRamBar(usedMb, maxMb, ramPercent);
+        final float progress = (float) Math.max(0.0, Math.min(ramPercent / 100.0, 1.0));
+        final Color colour = ramPercent >= 85 ? Color.RED
+            : ramPercent >= 70 ? Color.YELLOW
+            : Color.GREEN;
+
+        for (final Map.Entry<UUID, BossBar> entry : RAM_BAR_USERS.entrySet()) {
+            final Player player = Bukkit.getPlayer(entry.getKey());
+            if (player == null) {
+                continue;
+            }
+            final BossBar bar = entry.getValue();
+            if (!hasBossBar(player, bar)) {
+                player.showBossBar(bar);
+            }
+            bar.name(title);
+            bar.progress(progress);
+            bar.color(colour);
+        }
+    }
+
+    private static boolean hasBossBar(final Player player, final BossBar bar) {
+        for (final BossBar active : player.activeBossBars()) {
+            if (active == bar) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    // ---- warnings -------------------------------------------------------------------------
+
+    private static void pushWarnings(final TpsSnapshot tps, final long usedMb, final long maxMb, final int ramPercent) {
+        if (!SeaConfig.isMonitorWarningEnabled()) {
+            return;
+        }
+        final boolean lowTps = tps.medianTps < SeaConfig.monitorWarnTpsThreshold;
+        final boolean highRam = ramPercent >= SeaConfig.monitorWarnRamPercent;
+        if (!lowTps && !highRam) {
+            return;
+        }
+
+        final Component warn;
+        if (lowTps && highRam) {
+            warn = Component.text()
+                .append(Component.text("\u26a0 ", NamedTextColor.DARK_RED))
+                .append(Component.text("WARNING ", NamedTextColor.DARK_RED))
+                .append(Component.text("TPS ", NamedTextColor.GRAY))
+                .append(Component.text(ONE_DEC.format(tps.medianTps), CommandUtil.getColourForTPS(tps.medianTps)))
+                .append(Component.text("  RAM ", NamedTextColor.GRAY))
+                .append(Component.text(usedMb + "MB", NamedTextColor.RED))
+                .append(Component.text("/" + maxMb + "MB (" + ramPercent + "%)", NamedTextColor.GRAY))
+                .build();
+        } else if (lowTps) {
+            warn = Component.text()
+                .append(Component.text("\u26a0 ", NamedTextColor.RED))
+                .append(Component.text("LOW TPS: ", NamedTextColor.RED))
+                .append(Component.text(ONE_DEC.format(tps.medianTps), CommandUtil.getColourForTPS(tps.medianTps)))
+                .append(Component.text(" (worst " + ONE_DEC.format(tps.minTps) + ")", NamedTextColor.GRAY))
+                .build();
+        } else {
+            warn = Component.text()
+                .append(Component.text("\u26a0 ", NamedTextColor.RED))
+                .append(Component.text("HIGH MEMORY: ", NamedTextColor.RED))
+                .append(Component.text(usedMb + "MB", NamedTextColor.RED))
+                .append(Component.text("/" + maxMb + "MB (" + ramPercent + "%)", NamedTextColor.GRAY))
+                .build();
+        }
+
+        for (final Player player : Bukkit.getOnlinePlayers()) {
+            if (player.isOp() || player.isPermissionSet("sea.monitor.warn")) {
+                player.sendActionBar(warn);
+            }
+        }
+        MinecraftServer.LOGGER.warn("[SeaMonitor] {} TPS={} (median={}) RAM={}MB/{}MB ({}%)",
+                lowTps ? "Low TPS" : "High memory", NO_DEC.format(tps.minTps), ONE_DEC.format(tps.medianTps),
+                usedMb, maxMb, ramPercent);
+    }
+
+    // ---- bar builders ---------------------------------------------------------------------
+
+    private static Component buildTpsBar(final TpsSnapshot tps) {
+        return Component.text()
+            .append(Component.text("TPS ", NamedTextColor.DARK_GRAY))
+            .append(Component.text(TWO_DEC.format(tps.medianTps), CommandUtil.getColourForTPS(tps.medianTps)))
+            .append(Component.text("  MSPT ", NamedTextColor.DARK_GRAY))
+            .append(Component.text(TWO_DEC.format(tps.mspt), CommandUtil.getColourForMSPT(tps.mspt)))
+            .append(Component.text("  Worst ", NamedTextColor.DARK_GRAY))
+            .append(Component.text(TWO_DEC.format(tps.worstMspt), CommandUtil.getColourForMSPT(tps.worstMspt)))
+            .build();
+    }
+
+    private static Component buildRamBar(final long usedMb, final long maxMb, final int ramPercent) {
+        final TextColor colour = colourForPercent(ramPercent);
+        return Component.text()
+            .append(Component.text("RAM ", NamedTextColor.DARK_GRAY))
+            .append(Component.text(usedMb + "MB", colour))
+            .append(Component.text(" / ", NamedTextColor.DARK_GRAY))
+            .append(Component.text(maxMb + "MB", NamedTextColor.AQUA))
+            .append(Component.text(" (", NamedTextColor.DARK_GRAY))
+            .append(Component.text(ramPercent + "%", colour))
+            .append(Component.text(")", NamedTextColor.DARK_GRAY))
+            .build();
+    }
+
+    private static TextColor colourForPercent(final int percent) {
+        if (percent >= 95) {
+            return NamedTextColor.DARK_RED;
+        }
+        if (percent >= 85) {
+            return NamedTextColor.RED;
+        }
+        if (percent >= 70) {
+            return NamedTextColor.GOLD;
+        }
+        if (percent >= 50) {
+            return NamedTextColor.YELLOW;
+        }
+        return NamedTextColor.GREEN;
+    }
+
+    // ---- server-wide stats ------------------------------------------------------------------
+
+    private record TpsSnapshot(double medianTps, double minTps, double mspt, double worstMspt) {
+    }
+
+    /**
+     * Mirrors the metric maths used by Folia's own {@code /tps} command so the numbers in the bar
+     * always match what the server reports: TPS comes from {@code tpsData} while MSPT is the real
+     * tick execution time in {@code timePerTickData()}. Trying to derive MSPT as 1000/tps is wrong
+     * (a healthy 20 TPS region would wrongly read as 50 MSPT).
+     */
+    private static TpsSnapshot computeServerTps(final long now) {
+        final double[] minTpsHolder = {20.0};
+        final double[] worstMsptHolder = {0.0};
+        final List<Double> tpsPerRegion = new ArrayList<>();
+        final List<Double> msptPerRegion = new ArrayList<>();
+
+        for (final World bukkitWorld : Bukkit.getWorlds()) {
+            final net.minecraft.server.level.ServerLevel world = ((CraftWorld) bukkitWorld).getHandle();
+            world.regioniser.computeForAllRegions(region -> {
+                final TickData.TickReportData report = region.getData().getRegionSchedulingHandle().getTickReport15s(now);
+                if (report != null) {
+                    final double tps = report.tpsData().segmentAll().average();
+                    final double mspt = report.timePerTickData().segmentAll().average() / 1.0E6;
+                    minTpsHolder[0] = Math.min(minTpsHolder[0], tps);
+                    worstMsptHolder[0] = Math.max(worstMsptHolder[0], mspt);
+                    tpsPerRegion.add(tps);
+                    msptPerRegion.add(mspt);
+                }
+            });
+        }
+
+        if (tpsPerRegion.isEmpty()) {
+            return new TpsSnapshot(20.0, 20.0, 0.0, 0.0);
+        }
+        return new TpsSnapshot(median(tpsPerRegion), minTpsHolder[0], median(msptPerRegion), worstMsptHolder[0]);
+    }
+
+    private static double median(final List<Double> values) {
+        final List<Double> sorted = new ArrayList<>(values);
+        sorted.sort(Double::compare);
+        final int middle = sorted.size() >> 1;
+        return (sorted.size() & 1) == 0
+            ? (sorted.get(middle - 1) + sorted.get(middle)) / 2.0
+            : sorted.get(middle);
+    }
+}
